# Base de Datos PostgreSQL
# Para desarrollo local:
DB_NAME=tiendaRopa
DB_USER=postgres
DB_PASSWORD=tu_password_seguro
DB_HOST=localhost
DB_PORT=5432

# Para producción en Render, la DATABASE_URL se configura automáticamente
# con el formato: postgresql+asyncpg://usuario:password@host:puerto/database
DATABASE_URL=

# JWT Configuration - CAMBIA ESTO EN PRODUCCION
SECRET_KEY=cambia_esto_por_una_clave_aleatoria_larga_y_segura
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Inteligencia Artificial (Groq) - Opcional
GROQ_API_KEY=

# Cloudinary (Almacenación de Imágenes) - Opcional
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Stripe (Pagos) - Opcional
STRIPE_API_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=https://tu-frontend.com/pago-exitoso
STRIPE_CANCEL_URL=https://tu-frontend.com/pago-cancelado

# PayPal (Pagos) - Opcional
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# Configuración de la Aplicación
APP_NAME=FashionStore API
APP_VERSION=1.0.0
DEBUG=False

# CORS - Agrega los dominios de tu frontend
CORS_ORIGINS=http://localhost:4200,http://localhost:3000
