# Base de Datos PostgreSQL
# Para desarrollo local:
DB_NAME=tiendaRopa
DB_USER=postgres
DB_PASSWORD=tu_password_seguro
DB_HOST=localhost
DB_PORT=5432

# Para producción en Render, la DATABASE_URL se configura automáticamente
# con el formato: postgresql+asyncpg://usuario:password@host:puerto/database
DATABASE_URL=

# JWT Configuration - CAMBIA ESTO EN PRODUCCION
SECRET_KEY=cambia_esto_por_una_clave_aleatoria_larga_y_segura
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Inteligencia Artificial (Groq) - Opcional
GROQ_API_KEY=

# Cloudinary (Almacenación de Imágenes) - Opcional
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Stripe (Pagos) - Opcional
STRIPE_API_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=https://tu-frontend.com/pago-exitoso
STRIPE_CANCEL_URL=https://tu-frontend.com/pago-cancelado
STRIPE_SUSCRIPCION_SUCCESS_URL=https://tu-frontend.com/suscripcion-exitosa
STRIPE_SUSCRIPCION_CANCEL_URL=https://tu-frontend.com/suscripcion-cancelada

# PayPal (Pagos) - Opcional
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# Configuración de la Aplicación
APP_NAME=FashionStore API
APP_VERSION=1.0.0
DEBUG=False

# CORS - Agrega los dominios de tu frontend
CORS_ORIGINS=http://localhost:4200,http://localhost:3000

# ============================================================
# EXAMEN 2 — SaaS multitenant (Fase 1)
# ============================================================
SAAS_MODO_ESTRICTO=true
TENANT_HEADER_HABILITADO=true

# Plazos de cambio/devolución (RN-012)
PLAZO_DEVOLUCION_DIAS=7
PLAZO_CAMBIO_DIAS=7
PLAZO_CAMBIO_PROMOCION_HORAS=48

# Operación offline y sesión offline (CU05–CU09, CU17)
OFFLINE_LOTE_MAX_OPERACIONES=50
OFFLINE_MAX_DIAS_PENDIENTE=30
OFFLINE_BACKOFF_BASE_SEG=5
SYNC_CONFLICTO_UMBRAL_PRECIO=0.05
OFFLINE_PIN_MAX_INTENTOS=5
OFFLINE_PIN_LONGITUD_MIN=6
OFFLINE_SESION_HORAS_DEFECTO=12
OFFLINE_MAX_CLIENTES_DEFECTO=100
OFFLINE_RETENCION_DIAS=90
DISPOSITIVO_REVOCACION_AUTOMATICA_DIAS=90

# Idempotencia
IDEMPOTENCIA_TTL_HORAS=48

# Stripe: suscripciones y pagos diferidos
STRIPE_WEBHOOK_SECRET_SUSCRIPCIONES=
STRIPE_WEBHOOK_SECRET_PAGOS=
STRIPE_PRICE_BASICO=
STRIPE_PRICE_PROFESIONAL=
STRIPE_MONEDA=bob
STRIPE_API_VERSION=
PAGO_DIFERIDO_VIGENCIA_HORAS=24
PAGO_DIFERIDO_MAX_REINTENTOS=5
PAGO_DIFERIDO_BACKOFF_BASE_SEG=10

# Analítica / IA / ML (Fase 3)
DASHBOARD_CACHE_TTL_SEG=300
IA_MAX_FILAS=5000
IA_TIMEOUT_SEG=20
IA_PLANTILLAS_HABILITADAS=
ML_RUTA_MODELOS=./modelos_ml
ML_MIN_MESES_HISTORIAL=3
ML_MAX_FILAS_ENTRENAMIENTO=200000
EXPORT_MAX_MB=50

# Respaldos por tenant (Fase B / punto 6)
BACKUP_MODO=logico  # logico: .json.gz | sql: .sql (INSERTs por tenant) | pg_dump: .dump custom
BACKUP_DIR=./backups
BACKUP_PERMITE_RESTAURACION=false
BACKUP_JOB_INTERVALO_SEG=3600
BACKUP_TIMEOUT_SEG=300
